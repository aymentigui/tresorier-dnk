datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS (القوائم الثابتة) ---
enum ChequeType {
  BANQUE
  SIMPLE
}

enum ChequeStatut {
  EN_CIRCULATION
  DECAISSE
  ANNULE
}

enum FactureStatut {
  EN_ATTENTE
  PARTIELLEMENT_PAYEE
  PAYEE
}

enum FraisType {
  TAX
  VIREMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  BLOCK
  UNBLOCK
  ACTIVATE_SOLDE
  CANCEL // لإلغاء شيك
  REACTIVATE // لإعادة تفعيل شيك ملغى
  RENEW // لتجديد عقد
}

// --- MODELS (الجداول) ---

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  email               String?
  passwordHash        String
  fullName            String
  isBlocked           Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  roles     Role[]
  auditLogs AuditLog[]
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[]
}

model Permission {
  id       String @id @default(cuid())
  code     String @unique
  label    String
  resource String
  roles    Role[]
}

model Fournisseur {
  id       String  @id @default(cuid())
  nom      String  @unique
  activite String?

  // -- العتبة والمبلغ المتراكم --
  cumulMontant Decimal  @default(0) @db.Decimal(15, 2)
  seuil        Decimal? @db.Decimal(15, 2)
  seuilActive  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cheques      Cheque[]
  bonCommandes BonCommande[]
  contrats     Contrat[]
  factures     Facture[]
}

model BonCommande {
  id          String   @id @default(cuid())
  numero      String   @unique
  designation String?
  date        DateTime @db.Date
  montant     Decimal  @db.Decimal(15, 2)

  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factures Facture[]
}

model Contrat {
  id          String    @id @default(cuid())
  numero      String    @unique
  designation String?
  date        DateTime  @db.Date
  dateFin     DateTime? @db.Date
  montant     Decimal   @db.Decimal(15, 2)

  // -- الجديد: الاستهلاك الأولي، العتبة والتجديد --
  montantConsommeInitial Decimal  @default(0) @db.Decimal(15, 2) // <--- أضفنا هذا الحقل لحساب الفواتير القديمة
  seuil                  Decimal? @db.Decimal(15, 2)
  seuilActive            Boolean  @default(false)
  isActive               Boolean  @default(true)

  parentId String? // للاحتفاظ بالعقد القديم عند التجديد
  parent   Contrat?  @relation("ContratRenewal", fields: [parentId], references: [id])
  renewals Contrat[] @relation("ContratRenewal")

  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factures Facture[]
}

model Facture {
  id          String   @id @default(cuid())
  numero      String   @unique
  designation String?
  description String?  @db.Text
  date        DateTime @db.Date
  montant     Decimal  @db.Decimal(15, 2)

  // -- حالة الدفع --
  statut      FactureStatut @default(EN_ATTENTE)
  pourcentage Decimal       @default(0) @db.Decimal(5, 2) // نسبة الدفع %

  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  bonCommandeId String?
  bonCommande   BonCommande? @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)

  contratId String?
  contrat   Contrat? @relation(fields: [contratId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cheques Cheque[]
}

model Client {
  id            String         @id @default(cuid())
  nom           String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  encaissements Encaissement[]
}

model Cheque {
  id               String     @id @default(cuid())
  numeroCheque     String
  montant          Decimal    @db.Decimal(15, 2)
  reference        String?
  dateCreation     DateTime   @db.Date
  dateDecaissement DateTime?  @db.Date
  type             ChequeType

  // -- الإلغاء والتعليق والربط بالفاتورة --
  statut         ChequeStatut @default(EN_CIRCULATION)
  dateAnnulation DateTime?    @db.Date
  commentaire    String?      @db.Text

  factureId String?
  facture   Facture? @relation(fields: [factureId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])

  @@index([dateCreation])
  @@index([dateDecaissement])
  @@index([fournisseurId])
  @@index([factureId])
}

model Encaissement {
  id               String    @id @default(cuid())
  montant          Decimal   @db.Decimal(15, 2)
  reference        String?
  dateCreation     DateTime  @db.Date
  dateEncaissement DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  @@index([dateCreation])
  @@index([dateEncaissement])
  @@index([clientId])
}

model LigneCredit {
  id           String    @id @default(cuid())
  montant      Decimal   @db.Decimal(15, 2)
  dateCreation DateTime  @db.Date
  dateFin      DateTime? @db.Date
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dateCreation])
  @@index([isActive])
}

model Frais {
  id           String    @id @default(cuid())
  nom          String
  montant      Decimal   @db.Decimal(15, 2)
  dateCreation DateTime  @db.Date
  type         FraisType
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([dateCreation])
}

model SoldeBanque {
  id           String   @id @default(cuid())
  montant      Decimal  @db.Decimal(15, 2)
  dateCreation DateTime @db.Date
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dateCreation])
  @@index([active])
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entity      String
  entityId    String?
  description String
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  username    String?
  createdAt   DateTime    @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
}
